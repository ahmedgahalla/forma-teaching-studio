# Server-side only. Never put this key in frontend or NEXT_PUBLIC_* settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional OpenAI-compatible Responses provider. For OpenRouter, use its API key:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-6-luna
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional separate model for read-only scene explanations; defaults to OPENAI_MODEL.
# OPENAI_ANALYSIS_MODEL=openai/gpt-6-luna
