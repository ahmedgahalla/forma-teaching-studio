{
  "name": "dental-studio",
  "version": "0.12.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:limits": "node scripts/check-file-limits.mjs",
    "setup": "node scripts/setup.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "prebuild": "node scripts/build-mechanics-worker.mjs",
    "predev": "node scripts/build-mechanics-worker.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
